{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "lib": ["DOM", "ES2023"],
    "jsx": "react-jsx",
    "moduleResolution": "Node",
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "baseUrl": ".",
    "paths": {
      "@ui/*": ["src/ui/*"],
      "@services/*": ["src/services/*"],
      "@store/*": ["src/store/*"],
      "@components/*": ["src/components/*"],
      "@configs/*": ["./configs/*"],
      "@utils/*": ["./src/utils/*"],
      "@hooks/*": ["./src/hooks/*"]
    }
  },
  "include": ["src", "index.html"],
  "exclude": ["node_modules", "build"]
}
